# Live mode for `python -m leadforge.cli local`: copy to .env in the project folder and
# fill in your own keys. Never commit .env. Data goes to var/live.db, apart from the demo.
MOCK_APIS=false

# Required for real businesses: Google Places API (New). Billed by Google; LeadForge stops
# paid calls at monthly_budget_usd in config/agency.yaml.
GOOGLE_PLACES_API_KEY=

# Optional: without these, LeadForge uses its built-in fallbacks.
GOOGLE_PSI_API_KEY=       # PageSpeed scores (free key)
ANTHROPIC_API_KEY=        # better site copy and email drafts (otherwise templated text)
RESEND_API_KEY=           # needed only to actually send approved emails

# Change these before anyone else can reach this machine.
SEED_ADMIN_PASSWORD=admin-change-me-123
JWT_SECRET=
