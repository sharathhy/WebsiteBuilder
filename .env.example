# Copy to .env (API reads it from its working directory) or export in your shell.
# Never commit real values. Everything below is optional for local dev with MOCK_APIS=true.

ENV=dev                         # dev | test | prod
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://leadforge:leadforge@localhost:5432/leadforge
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=                     # >= 32 random chars; required in prod (openssl rand -hex 32)
CORS_ORIGINS=http://localhost:5173
MOCK_APIS=true                  # serve every external API from fixtures

# Seeded dev users (make seed)
SEED_ADMIN_EMAIL=admin@leadforge.local
SEED_ADMIN_PASSWORD=admin-change-me-123
SEED_REVIEWER_EMAIL=reviewer@leadforge.local
SEED_REVIEWER_PASSWORD=reviewer-change-me-123

# --- Keys for later phases (leave blank until needed) ---
GOOGLE_PLACES_API_KEY=          # Phase 2: Places API (New)
GOOGLE_PSI_API_KEY=             # Phase 3: PageSpeed Insights
ANTHROPIC_API_KEY=              # Phase 3+: vision review, site spec, email drafts
VERCEL_TOKEN=                   # Phase 6: preview deploys
RESEND_API_KEY=                 # Phase 7: sending (after approval only)
RESEND_WEBHOOK_SECRET=          # Phase 7: bounce/complaint webhook (svix "whsec_..." secret)
HIGGSFIELD_API_KEY=             # Phase 5/6: hero video
UNSPLASH_ACCESS_KEY=            # Phase 6: stock imagery
PEXELS_API_KEY=
TURNSTILE_SECRET_KEY=           # Phase 6: generated-site contact forms
SENTRY_DSN=                     # Phase 8 (optional earlier)
